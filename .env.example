# Copier en .env (jamais versionné). Toutes les variables sont lues par src/sinistre/config.py.

# --- LLM ---------------------------------------------------------------
# openai_compatible : OpenAI, Mistral, routeur, ou modèle auto-hébergé (vLLM, Ollama)
# anthropic         : SDK Anthropic natif
LLM_PROVIDER=openai_compatible

# Mistral (option souveraine, hébergement UE) :
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-small-latest
# OpenAI :            LLM_BASE_URL=   (vide)            LLM_MODEL=gpt-4.1-mini
# Auto-hébergé vLLM : LLM_BASE_URL=http://localhost:8000/v1   LLM_MODEL=<nom du modèle servi>
# Anthropic :         LLM_PROVIDER=anthropic            LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=

# --- Recherche ---------------------------------------------------------
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
